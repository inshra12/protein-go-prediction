cd ~/projects/protein-go-prediction

cat > .gitignore << 'EOF'
# Virtual environment
.venv/
venv/
env/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# Data & models (usually too large for Git)
data/raw/
data/processed/
*.pt
*.pth
*.h5
*.pkl
*.joblib

# Results (optional — you can track small tables/figures later)
results/figures/
results/tables/

# OS / editor
.DS_Store
.vscode/
*.swp

# Jupyter
.ipynb_checkpoints/
EOF
