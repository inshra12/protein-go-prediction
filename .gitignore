cd ~/projects/protein-go-prediction

cat > .gitignore << 'EOF'
# Virtual environment
.venv/
venv/
env/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# Keep the clean processed data, but ignore the full backup
data/processed_full_backup/
data/raw/

# Ignore other large/unnecessary model files if any appear later
*.pth
*.h5
*.pkl
*.joblib

# Results
results/figures/
results/tables/

# OS / editor
.DS_Store
.vscode/
*.swp
EOF
notebooks/
